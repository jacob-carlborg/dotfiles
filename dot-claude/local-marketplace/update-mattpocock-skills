#!/usr/bin/env bash
#
# Diffs the vendored Matt Pocock skills against the upstream commit that
# Anthropic's official marketplace pins: the latest commit that passed
# Anthropic's policy scan. With --apply, syncs the vendored skills to it.
# With --ref, uses any upstream commit instead, which Anthropic hasn't
# necessarily scanned.
#
# To add a skill, create its empty directory under plugins/mattpocock/skills/
# and run this: the whole skill then shows up in the diff.

set -euo pipefail

MARKETPLACE_URL="https://raw.githubusercontent.com/anthropics/claude-plugins-official/main/.claude-plugin/marketplace.json"
SKILLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/plugins/mattpocock/skills"

usage() {
  echo "usage: update-mattpocock-skills [--apply] [--ref <ref>]"
  echo ""
  echo "  (no option)  show the diff from the vendored skills to the pinned commit"
  echo "  --apply      sync the vendored skills to the pinned commit"
  echo "  --ref <ref>  use this upstream commit, branch or tag (e.g. HEAD) instead"
  echo "               of the pinned commit"
}

pinned_sha() {
  curl -fsSL "$MARKETPLACE_URL" |
    jq -er '.plugins[] | select(.name == "mattpocock-skills") | .source.sha'
}

resolve_ref() {
  local ref="$1"
  if ! curl -fsL -H "Accept: application/vnd.github.sha" \
    "https://api.github.com/repos/mattpocock/skills/commits/$ref"; then
    echo "error: can't resolve '$ref' in mattpocock/skills" >&2
    return 1
  fi
}

download() {
  local sha="$1" dest="$2"
  mkdir -p "$dest"
  curl -fsSL "https://codeload.github.com/mattpocock/skills/tar.gz/$sha" |
    tar -xz -C "$dest" --strip-components=1
}

upstream_path() {
  local source="$1" name="$2"
  jq -er --arg name "$name" '.skills[] | select(split("/") | last == $name)' \
    "$source/.claude-plugin/plugin.json"
}

# Copies each vendored skill to $work/vendored and its upstream version to
# $work/upstream, so a single diff covers every skill.
stage() {
  local work="$1" name path
  mkdir -p "$work/vendored" "$work/upstream"
  for dir in "$SKILLS_DIR"/*/; do
    name="$(basename "$dir")"
    if ! path="$(upstream_path "$work/source" "$name")"; then
      echo "warning: $name is not in the upstream plugin, skipping" >&2
      continue
    fi
    cp -R "$dir" "$work/vendored/$name"
    cp -R "$work/source/$path" "$work/upstream/$name"
  done
}

apply() {
  local work="$1"
  for dir in "$work/upstream"/*/; do
    rsync -a --delete "$dir" "$SKILLS_DIR/$(basename "$dir")/"
  done
}

main() {
  local mode="diff" ref=""
  while (($#)); do
    case "$1" in
      --apply) mode="apply" ;;
      --ref)
        [[ $# -ge 2 ]] || { usage >&2; exit 1; }
        ref="$2"
        shift
        ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 1 ;;
    esac
    shift
  done

  local sha work
  if [[ -n "$ref" ]]; then
    sha="$(resolve_ref "$ref")"
    echo "Upstream $ref: $sha (not necessarily scanned by Anthropic)"
  else
    sha="$(pinned_sha)"
    echo "Pinned by claude-plugins-official: $sha"
  fi

  work="$(mktemp -d)"
  # Expanded now: $work is local, so it's gone by the time the trap runs.
  # shellcheck disable=SC2064
  trap "rm -rf -- '$work'" EXIT

  download "$sha" "$work/source"
  stage "$work"

  if (cd "$work" && git diff --no-index --quiet vendored upstream); then
    echo "Vendored skills are up to date."
  elif [[ "$mode" == "apply" ]]; then
    apply "$work"
    echo "Synced to $sha. Then run: claude plugin update mattpocock@dotfiles"
  else
    (cd "$work" && git diff --no-index vendored upstream) || true
  fi
}

main "$@"
